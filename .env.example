# ============================================================
#  پیکربندی سرور فاکتوریزم — این فایل را به .env کپی و تکمیل کنید
# ============================================================

# محیط: development | production | test
NODE_ENV=production

# پورت سرور API
PORT=8787

# درایور دیتابیس: mysql (تولید) | memory (توسعه/دمو)
DB_DRIVER=mysql

# اتصال MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=faktorizm
MYSQL_PASSWORD=یک-رمز-قوی-اینجا
MYSQL_DATABASE=faktorizm
MYSQL_POOL=20

# کلید امضای JWT — حتما با مقدار تصادفی بلند جایگزین شود (مثلا: openssl rand -hex 48)
JWT_SECRET=یک-رشته-تصادفی-حداقل-۶۴-کاراکتری-اینجا
ACCESS_TTL=15m
ACCESS_TTL_MS=900000
REFRESH_TTL_DAYS=7

# مبداهای مجاز CORS (با کاما جدا کنید)
CORS_ORIGINS=https://app.yourdomain.ir

# دوره آزمایشی و سیاست قفل حساب
TRIAL_DAYS=14
MAX_LOGIN_FAILURES=5
LOCK_MINUTES=15
BCRYPT_ROUNDS=12

# سقف نرخ درخواست در هر ۱۵ دقیقه
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=20

# حساب مدیر اولیه (اختیاری، فقط اولین اجرا)
ADMIN_EMAIL=admin@yourdomain.ir
ADMIN_PASSWORD=StrongPass123

# حداکثر حجم بدنه درخواست
JSON_LIMIT=2mb
